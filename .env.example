# PostgreSQL - matches docker-compose.yml's postgres service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erpbackend
DB_USER=postgres
DB_PASSWORD=postgres

# Redis - matches docker-compose.yml's redis service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT signing - the default below is dev-only and NOT secure; always override in
# any shared or production environment.
JWT_SECRET=dev-only-insecure-jwt-signing-secret-change-me-in-production-0123456789
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Google OAuth2 sign-in / account linking - optional. Leave blank to keep the app booting
# with Google sign-in disabled (its endpoints return 503) until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
FRONTEND_BASE_URL=http://localhost:3000
